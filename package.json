{
  "name": "agrishop-platform",
  "version": "1.0.0",
  "description": "Agricultural Product Marketing Platform - Level 2 Software Engineering Project at IAI Cameroon",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "setup": "npm --prefix server run setup",
    "seed": "npm --prefix server run seed",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "agriculture",
    "marketplace",
    "farmer",
    "ecommerce",
    "iai-cameroon",
    "software-engineering"
  ],
  "author": "IAI Cameroon Software Engineering Student",
  "license": "ISC"
}
